# Subscription __NAME__ (rule: src/subscriptions/__NAME__.yml) — micro-batch (serverless, seconds).
resources:
  pipelines:
    sub___NAME__:
      name: hl7rt-${bundle.target}-sub-__NAME__
      catalog: ${var.catalog}
      schema: ${resources.schemas.hl7.name}
      serverless: true
      continuous: true
      root_path: ../../src
      libraries:
        - glob:
            include: ../../src/pipelines/subscriptions/**
      configuration:
        hl7.eh.namespace: ${var.eh_namespace}
        hl7.eh.secret_scope: ${var.eh_secret_scope}
        hl7.eh.secret_key: ${var.eh_secret_key}
        hl7.kafka.starting_offsets: ${var.kafka_starting_offsets}
        hl7.rtm.trigger_interval: ${var.rtm_trigger_interval}
        hl7.rtm.max_partitions: ${var.rtm_max_partitions}
        hl7.sub.rule: ${workspace.file_path}/src/subscriptions/__NAME__.yml
        hl7.topics.prefix: ${var.catalog}.${var.schema}
        hl7.topics.gold_encounters: ${var.hl7_gold_encounters_topic}
        hl7.topics.gold_observations: ${var.hl7_gold_observations_topic}
        hl7.topics.gold_orders: ${var.hl7_gold_orders_topic}
