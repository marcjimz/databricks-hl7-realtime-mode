# cp subscriber.properties.example subscriber.properties (gitignored), then fill in. No secrets here: the app signs in
# with the Databricks CLI profile below (~/.databrickscfg holds the SP's client_id / client_secret).
# `make registry` writes these for each onboarded app to apps/<app>.properties, so you usually don't need this file.

# The app's service principal profile in ~/.databrickscfg (host, client_id, client_secret).
databricks.profile = sp-my-app

# The Subscription API (a Databricks App): the one way to register subscriptions. The app looks up its URL by name;
# set api.url instead to point at it directly.
api.app = hl7-subscriptions-dev

# Everything else (this app's topic, Kafka bootstrap servers, UC credential) comes from GET /api/v1/connection.

# Optional: consumer group (defaults to the profile name).
# consumer.group = my-app
