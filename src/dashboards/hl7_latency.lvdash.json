{
  "datasets": [
    {
      "name": "hop_summary",
      "displayName": "Per-hop latency, last 15 minutes",
      "queryLines": [
        "SELECT hop, count(*) AS messages,\n",
        "  round(percentile_approx(hop_ms, 0.5)) AS p50_ms, round(percentile_approx(hop_ms, 0.95)) AS p95_ms,\n",
        "  round(percentile_approx(hop_ms, 0.99)) AS p99_ms, round(max(hop_ms)) AS max_ms,\n",
        "  round(avg(CASE WHEN hop_ms < 200 THEN 1.0 ELSE 0.0 END), 4) AS under_200ms\n",
        "FROM (SELECT '1 raw → bronze' AS hop, kafka_timestamp AS ts, hop_ms, e2e_ms FROM bronze_hl7\n",
        "UNION ALL SELECT '2 bronze → silver', kafka_timestamp, hop_ms, e2e_ms FROM silver_hl7\n",
        "UNION ALL SELECT '3 silver → gold', kafka_timestamp, hop_ms, e2e_ms FROM gold_observations\n",
        "UNION ALL SELECT concat('4 gold → ', subscription, CASE WHEN mode = 'microbatch' THEN ' (micro-batch)' ELSE '' END),\n",
        "  kafka_timestamp, hop_ms, e2e_ms FROM subscription_latency) WHERE ts >= timestampadd(MINUTE, -15, current_timestamp()) AND hop_ms < 600000 GROUP BY hop ORDER BY hop\n"
      ]
    },
    {
      "name": "hop_trend",
      "displayName": "Per-hop p99 by minute, last hour",
      "queryLines": [
        "SELECT hop, date_trunc('MINUTE', ts) AS minute,\n",
        "  round(percentile_approx(hop_ms, 0.99)) AS p99_ms\n",
        "FROM (SELECT '1 raw → bronze' AS hop, kafka_timestamp AS ts, hop_ms, e2e_ms FROM bronze_hl7\n",
        "UNION ALL SELECT '2 bronze → silver', kafka_timestamp, hop_ms, e2e_ms FROM silver_hl7\n",
        "UNION ALL SELECT '3 silver → gold', kafka_timestamp, hop_ms, e2e_ms FROM gold_observations\n",
        "UNION ALL SELECT concat('4 gold → ', subscription, CASE WHEN mode = 'microbatch' THEN ' (micro-batch)' ELSE '' END),\n",
        "  kafka_timestamp, hop_ms, e2e_ms FROM subscription_latency) WHERE ts >= timestampadd(MINUTE, -60, current_timestamp()) AND hop_ms < 600000 GROUP BY hop, date_trunc('MINUTE', ts)\n"
      ]
    },
    {
      "name": "kpis",
      "displayName": "Headline numbers, last 15 minutes",
      "queryLines": [
        "SELECT\n",
        "  (SELECT round(count(*) / 900.0, 1) FROM raw_hl7 WHERE kafka_timestamp >= timestampadd(MINUTE, -15, current_timestamp())) AS msgs_per_sec,\n",
        "  (SELECT round(percentile_approx(e2e_ms, 0.99)) FROM gold_observations WHERE kafka_timestamp >= timestampadd(MINUTE, -15, current_timestamp()) AND e2e_ms < 600000) AS raw_to_gold_p99_ms,\n",
        "  (SELECT count(*) FROM subscription_latency WHERE kafka_timestamp >= timestampadd(MINUTE, -15, current_timestamp())) AS subscription_records,\n",
        "  (SELECT count(*) FROM quarantine_hl7 WHERE kafka_timestamp >= timestampadd(MINUTE, -15, current_timestamp())) AS quarantined\n"
      ]
    },
    {
      "name": "alerts",
      "displayName": "Latest ED → critical lab matches",
      "queryLines": [
        "SELECT kafka_timestamp AS delivered_at, patient_id, patient_facility,\n",
        "  observation_cd_desc, value_num, abnormal_flag, round(matched_after_ms / 60000.0, 1) AS minutes_after_registration,\n",
        "  round(hop_ms) AS gold_to_sub_ms\n",
        "FROM sub_ed_critical_lab ORDER BY kafka_timestamp DESC LIMIT 50\n"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "Quarantine reasons, last hour",
      "queryLines": [
        "SELECT reason, count(*) AS messages FROM quarantine_hl7\n",
        "WHERE kafka_timestamp >= timestampadd(MINUTE, -60, current_timestamp()) GROUP BY reason\n"
      ]
    }
  ],
