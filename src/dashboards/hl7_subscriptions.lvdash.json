{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT count_if(state = 'ACTIVE') AS active, count_if(state = 'FAILED') AS failed, count(DISTINCT CASE WHEN state <> 'CANCELLED' THEN app_name END) AS apps FROM subscriptions"
      ]
    },
    {
      "name": "current",
      "displayName": "Current subscriptions (not cancelled)",
      "queryLines": [
        "SELECT app_name, service_principal, subscription, revision, source, state, rule, fields, error, registered_at, confirmed_at, seconds_to_confirm FROM subscriptions WHERE state <> 'CANCELLED' ORDER BY app_name, subscription"
      ]
    },
    {
      "name": "by_app",
      "displayName": "Subscriptions per app and state",
      "queryLines": [
        "SELECT app_name, state, count(*) AS subscriptions FROM subscriptions WHERE state <> 'CANCELLED' GROUP BY app_name, state"
      ]
    },
    {
      "name": "hub_health",
      "displayName": "Hub heartbeat per gold source",
      "queryLines": [
        "SELECT source, CASE WHEN seconds_since_last_batch > 120 THEN 'STALE' ELSE 'OK' END AS status, seconds_since_last_batch, last_batch_at, batch_id, rules FROM hub ORDER BY source"
      ]
    },
    {
      "name": "cancelled",
      "displayName": "Cancelled subscriptions",
      "queryLines": [
        "SELECT app_name, service_principal, subscription, revision, source, state, rule, fields, error, registered_at, confirmed_at, seconds_to_confirm FROM subscriptions WHERE state = 'CANCELLED' ORDER BY registered_at DESC"
      ]
    }
  ],
